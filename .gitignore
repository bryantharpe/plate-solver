# Claude Code: local settings and the app's per-session worktrees (.claude/worktrees/)
# stay local. The project's skills and agents (Impeccable, the UI design skill) are
# committed so every session has them, cloud sessions included. Impeccable's engine
# binary is per-platform: its launcher downloads and checksums it on first use.
.claude/*
!.claude/skills/
!.claude/agents/
.claude/skills/impeccable/scripts/bin/

# macOS
.DS_Store

# Rust
/target

# ps-web frontend (NOTE: frontend/dist is committed by design — the Rust
# binary embeds it via rust-embed so cargo builds never need node)
ps-web/frontend/node_modules/

# Standalone parity-capture helper crate (workspace-excluded; builds its own target)
tools/parity/_capture_binning/target/
tools/parity/_capture_binning/Cargo.lock

# Parity venvs
tools/parity/.venv
tools/parity/.venv-tetra3-orig

# feat-09 eval-harness: regenerable catalog + run output, not source
tools/parity/benchmark/generated/*.bin
tools/parity/benchmark/results.json

# Python bytecode (e.g. from running the vendored cedar-solve)
__pycache__/

# Coverage output from cargo llvm-cov (CI's test-coverage job writes it)
lcov.info
